# SITE_ADDRESS가 도메인이면 HTTPS 인증서를 자동으로 받는다 (예: 34-64-12-34.sslip.io).
# 비워 두면 :80 으로 HTTP만 연다 (로컬 확인용).
{$SITE_ADDRESS} {
	encode gzip

	# /api/auth/login → backend의 /auth/login (개발 서버 프록시와 같은 규칙)
	handle_path /api/* {
		# 가장 큰 요청은 코드 64KB + 입력 64KB. 그보다 훨씬 큰 요청은 backend까지 보내지 않는다
		request_body {
			max_size 512KB
		}
		reverse_proxy backend:8000
	}

	handle {
		root * /srv
		# 화면 주소(/plan, /blocks/... )로 바로 들어와도 index.html을 준다
		try_files {path} /index.html
		file_server

		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@html not path /assets/*
		header @html Cache-Control "no-cache"
	}

	header {
		# 1년 동안 이 주소는 HTTPS로만 접속
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		# 다른 사이트가 이 화면을 iframe에 넣지 못하게 (클릭재킹 방지)
		X-Frame-Options DENY
		Content-Security-Policy "frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		-Server
	}
}
